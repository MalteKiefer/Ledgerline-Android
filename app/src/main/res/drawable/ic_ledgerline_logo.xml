<?xml version="1.0" encoding="utf-8"?>
<!-- In-app brand mark: an indigo → violet gradient shield with a bold white
     padlock, matching the iOS app icon and the launcher icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Gradient shield -->
    <path android:pathData="M48,8 L74,19 C77,20.2 78,22 78,25 L78,50 C78,70 64,80 48,86 C32,80 18,70 18,50 L18,25 C18,22 19,20.2 22,19 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18" android:startY="8"
                android:endX="78" android:endY="86"
                android:startColor="#7066F5"
                android:endColor="#9E70FA" />
        </aapt:attr>
    </path>

    <!-- Padlock shackle (white arch) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M39,49 v-6 a9,9 0 0 1 18,0 v6" />

    <!-- Padlock body (white rounded rect) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,47 h24 a5,5 0 0 1 5,5 v15 a5,5 0 0 1 -5,5 h-24 a5,5 0 0 1 -5,-5 v-15 a5,5 0 0 1 5,-5 z" />
</vector>
