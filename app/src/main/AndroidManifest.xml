<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location: geotag photos, and record GPS tracks in the Explore/Tracker feature.
         Background location powers continuous track recording behind a visible foreground
         notification; coordinates are recorded on-device and only persisted (encrypted) on
         save. Never sent to the server in the clear. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Optional: sync the encrypted address book with the device contacts app.
         Read/write only the local "Ledgerline" account; never uploaded anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Optional: read device photos/videos for camera-roll backup into the gallery. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Foreground service keeps long ops (scans/uploads) alive when backgrounded,
         behind a visible notification. Data-sync type; AOSP only, no Google. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calendar reminders fire at an exact minute; USE_EXACT_ALARM is the calendar/alarm use case. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- See installed browsers (Android 11+ package visibility) so the "ask which
         browser" link chooser can enumerate them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LedgerlineApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ledgerline">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ledgerline" android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.share.ShareActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ledgerline">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.calendar.CalendarReminderReceiver"
            android:exported="false" />

        <service
            android:name=".core.ops.BackgroundOpService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- GPS track recording: keeps location updates flowing while backgrounded, behind a
             visible ongoing notification. AOSP LocationManager only, no Google Play Services. -->
        <service
            android:name=".core.tracker.TrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Zero-knowledge Autofill provider. Structure-only in onFillRequest; the vault
             is decrypted solely after the user authenticates in AutofillUnlockActivity. -->
        <service
            android:name=".core.autofill.LedgerlineAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Authenticated fill/save bridge launched by the OS from the autofill entry. -->
        <activity
            android:name=".ui.autofill.AutofillUnlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ledgerline" />

        <!-- Zero-knowledge WebAuthn passkey provider (Android Credential Manager). -->
        <service
            android:name=".core.passkey.LedgerlinePasskeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/passkey_provider" />
        </service>

        <!-- Unlock-gated activity that completes passkey create/get/assert ceremonies. -->
        <activity
            android:name=".ui.passkey.PasskeyProviderActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ledgerline" />
    </application>
</manifest>
